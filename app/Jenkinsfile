pipeline {
  agent any

  environment {
    AWS_REGION  = 'ap-south-1'
    ECR_REPO    = '564623062186.dkr.ecr.ap-south-1.amazonaws.com/argocd-lab-web'
    GITOPS_FILE = 'gitops/envs/dev/deployment.yaml'
    LAB_REPO    = 'github.com/discover-devops/argocd-jenkins-lab.git'
  }

  stages {
    stage('1. Checkout') {
      steps {
        checkout scm
        script {
          env.TAG = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim() + "-" + env.BUILD_NUMBER
        }
        echo "Building version ${env.TAG}"
      }
    }

    stage('2. Build image') {
      steps {
        sh 'docker build --build-arg APP_VERSION=$TAG -t $ECR_REPO:$TAG app'
      }
    }

    stage('3. Push to ECR') {
      steps {
        sh 'aws ecr get-login-password --region $AWS_REGION | docker login --username AWS --password-stdin ${ECR_REPO%/*}'
        sh 'docker push $ECR_REPO:$TAG'
      }
    }

    stage('4. Update GitOps (dev)') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'github-token', usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
          sh '''
            git config user.name  "Jenkins"
            git config user.email "jenkins@argocd-lab.local"
            git fetch origin main
            git checkout -B main origin/main
            sed -i "s#image: .*#image: $ECR_REPO:$TAG#" $GITOPS_FILE
            git add $GITOPS_FILE
            git commit -m "Deploy $TAG to dev" || echo "Nothing to commit"
            git push https://$GH_USER:$GH_TOKEN@$LAB_REPO main
          '''
        }
      }
    }
  }

  post {
    success {
      echo "Done. Jenkins changed Git only. Argo CD will deploy ${env.TAG} to dev."
    }
  }
}
