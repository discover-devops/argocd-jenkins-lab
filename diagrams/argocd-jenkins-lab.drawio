etry"/></mxCell><mxCell id="e" value="prod updated&lt;br&gt;by Argo CD" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;arcSize=10;fontFamily=Comic Sans MS;fontStyle=1;fontSize=30;fillColor=#d5e8d4;strokeColor=#3f6b2e;" vertex="1" parent="1"><mxGeometry x="2480" y="250" width="480" height="200" as="geometry"/></mxCell><mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;html=1;endArrow=classic;endSize=14;strokeColor=#222222;fontFamily=Comic Sans MS;fontStyle=1;fontSize=26;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;html=1;endArrow=classic;endSize=14;strokeColor=#222222;fontFamily=Comic Sans MS;fontStyle=1;fontSize=26;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;html=1;endArrow=classic;endSize=14;strokeColor=#222222;fontFamily=Comic Sans MS;fontStyle=1;fontSize=26;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c" target="d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;html=1;endArrow=classic;endSize=14;strokeColor=#222222;fontFamily=Comic Sans MS;fontStyle=1;fontSize=26;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d" target="e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sh" value="Self heal: kubectl scale by hand, Argo CD puts it back to Git.&lt;br&gt;Rollback: git revert, Argo CD deploys the old tag." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;arcSize=10;fontFamily=Comic