d = cluster hacked&lt;br&gt;no audit, drift unseen" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;arcSize=10;fontFamily=Comic Sans MS;fontStyle=1;fontSize=30;fillColor=#f8cecc;strokeColor=#8f3330;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="1400" height="160" as="geometry"/></mxCell><mxCell id="lh" value="PULL (GitOps)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;arcSize=10;fontFamily=Comic Sans MS;fontStyle=1;fontSize=30;fillColor=#d5e8d4;strokeColor=#3f6b2e;" vertex="1" parent="1"><mxGeometry x="1560" y="190" width="1400" height="100" as="geometry"/></mxCell><mxCell id="lj" value="Jenkins&lt;br&gt;changes Git only" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;arcSize=10;fontFamily=Comic Sans MS;fontStyle=1;fontSize=30;fillColor=#d5e8d4;strokeColor=#3f6b2e;" vertex="1" parent="1"><mxGeometry x="1560" y="330" width="640" height="200" as="geometry"/></mxCell><mxCell id="lg" value="Git" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;arcSize=10;fontFamily=Comic Sans MS;fontStyle=1;fontSize=30;fillColor=#fff2cc;strokeColor=#8f7426;" vertex="1" parent="1"><mxGeometry x="2320" y="330" width="640" height="200" as="geometry"/></mxCell><mxCell id="la" value="Argo CD in cluster&lt;br&gt;pulls and applies" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;arcSize=10;fontFamily=Comic Sans MS;fontStyle=1;fontSize=30;fillColor=#d5e8d4;strokeColor=#3f6b2e;" vertex="1" parent="1"><mxGeometry x="2320" y="580" width="640" height="200" as="geometry"/></mxCell><mxCell id="z2" value="commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;html=1;endArrow=classic;endSize=14;strokeColor=#222222;fontFamily=Comic Sans MS;fontStyle=1;fontSize=26;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lj" target="lg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z3" value="pull" style="edgeStyle=orthogonalEdgeStyle;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;html=1;endArrow=classic;endSize=14;strokeColor=#222222;fontFamily=Comic Sans MS;fontStyle=1;fontSize=26;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="lg" target="la"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cc830" value="Concept&lt;br&gt;In GitOps an agent inside the cluster pulls desired state from Git.&lt;br&gt;Credentials never leave the cluster. Every change is a commit." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;arcSize=10;fontFamily=Comic Sans MS;fontStyle=1;fontSize=30;fillColor=#d5e8d4;strokeColor=#3f6b2e;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="1700" height="260" as="geometry"/></mxCell><mxCell id="iq830" value="Interview Question&lt;br&gt;Why should a CI server never hold a production kubeconfig?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;arcSize=10;fontFamily=Comic Sans MS;fontStyle=1;fontSize=30;fillColor=#fff2cc;strokeColor=#8f7426;" vertex="1" parent="1"><mxGeometry x="1780" y="830" width="1180" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram>
