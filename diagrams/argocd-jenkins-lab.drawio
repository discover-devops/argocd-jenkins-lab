nded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;arcSize=10;fontFamily=Comic Sans MS;fontStyle=1;fontSize=30;fillColor=#f8cecc;strokeColor=#8f3330;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="200" height="130" as="geometry"/></mxCell><mxCell id="kd2" value="terraform destroy infra/ec2 (on laptop)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;arcSize=10;fontFamily=Comic Sans MS;fontStyle=1;fontSize=30;fillColor=#ffffff;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="280" y="530" width="2680" height="130" as="geometry"/></mxCell><mxCell id="k3" value="4" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;arcSize=10;fontFamily=Comic Sans MS;fontStyle=1;fontSize=30;fillColor=#f8cecc;strokeColor=#8f3330;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="200" height="130" as="geometry"/></mxCell><mxCell id="kd3" value="Check: no EKS, EC2, ELB, VPC left" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;arcSize=10;fontFamily=Comic Sans MS;fontStyle=1;fontSize=30;fillColor=#ffffff;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="280" y="700" width="2680" height="130" as="geometry"/></mxCell><mxCell id="cc900" value="Concept&lt;br&gt;Delete in reverse order of creation.&lt;br&gt;LoadBalancers made by Kubernetes block VPC deletion, so remove them first." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;arcSize=10;fontFamily=Comic Sans MS;fontStyle=1;fontSize=30;fillColor=#d5e8d4;strokeColor=#3f6b2e;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="1700" height="260" as="geometry"/></mxCell><mxCell id="iq900" value="Interview Question&lt;br&gt;Terraform destroy fails on a VPC. What is the usual cause?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;arcSize=10;fontFamily=Comic Sans MS;fontStyle=1;fontSize=30;fill