" parent="1"><mxGeometry x="40" y="850" width="1700" height="260" as="geometry"/></mxCell><mxCell id="iq850" value="Interview Question&lt;br&gt;How does EKS decide who can use kubectl? Access entries vs aws-auth." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;arcSize=10;fontFamily=Comic Sans MS;fontStyle=1;fontSize=30;fillColor=#fff2cc;strokeColor=#8f7426;" vertex="1" parent="1"><mxGeometry x="1780" y="850" width="1180" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram>
